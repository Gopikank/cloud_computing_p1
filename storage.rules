rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /question-papers/{ownerUid}/{paperId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/(pdf)|text/plain');

      allow read: if request.auth != null && (
        request.auth.uid == ownerUid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "examiner" &&
          firestore.get(/databases/(default)/documents/papers/$(paperId)).data.status == "RELEASED"
        )
      );
    }
  }
}
